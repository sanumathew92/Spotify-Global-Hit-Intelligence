
# ==========================================
# Python environments and cache
# ==========================================
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyo

# ==========================================
# Jupyter
# ==========================================
.ipynb_checkpoints/

# ==========================================
# Raw data - never upload raw datasets
# ==========================================
data/raw/*
!data/raw/README.md

# ==========================================
# Processed data - ignore by default
# ==========================================
data/processed/*
!data/processed/README.md

# ==========================================
# Deployment data - allow only required CSVs
# ==========================================
data/deployment/*
!data/deployment/spotify_global_chart_totals_lyrics_cleaned.csv
!data/deployment/spotify_lyrics_nlp_features.csv
!data/deployment/spotify_hit_segments.csv

# ==========================================
# Models
# ==========================================
models/*
!models/README.md

# ==========================================
# Generated figures - allow dashboard assets
# ==========================================
outputs/figures/*
!outputs/figures/machine_learning/
!outputs/figures/model_comparison/
!outputs/figures/shap/

# ==========================================
# Generated tables - ignore by default
# ==========================================
outputs/tables/*

# Final insights tables
!outputs/tables/final_insights/
outputs/tables/final_insights/*
!outputs/tables/final_insights/*.csv

# Machine learning tables
!outputs/tables/machine_learning/
outputs/tables/machine_learning/*
!outputs/tables/machine_learning/*.csv

# SHAP tables
!outputs/tables/shap/
outputs/tables/shap/*
!outputs/tables/shap/*.csv

# ==========================================
# Reports
# ==========================================
outputs/reports/*
!outputs/reports/executive_summary.txt

# ==========================================
# Notebook training artifacts
# ==========================================
notebook/catboost_info/
notebook/outputs/

# ==========================================
# Secrets and local configuration
# ==========================================
.env
.env.*
.streamlit/secrets.toml

# ==========================================
# IDE and operating system
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db
